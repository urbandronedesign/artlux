{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArtLuxLauncher",
  "version": "0.1.1",
  "mainBinaryName": "artlux-launcher",
  "identifier": "com.urbandronedesign.artlux.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArtLux Launcher",
        "width": 1080,
        "height": 720,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0d0d0d",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "copyright": "ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â© Zaki Jawhari and BÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©renger Recoules",
    "shortDescription": "Installs ArtLux and opens your projects.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": [
      "resources/preflight.ps1"
    ]
  }
}
