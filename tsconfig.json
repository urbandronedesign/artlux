{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "@webgpu/types"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/renderer/*"
      ],
      "@artlux/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@artlux/sdk/main": [
        "./packages/sdk/src/main.ts"
      ],
      "@artlux/sdk/renderer": [
        "./packages/sdk/src/renderer.ts"
      ],
      "@artlux/plugin-bake/main": [
        "./plugins/bake/src/main.ts"
      ],
      "@artlux/plugin-bake/renderer": [
        "./plugins/bake/src/renderer.ts"
      ],
      "@artlux/plugin-lidar-tracking": [
        "./plugins/lidar-tracking/src/index.ts"
      ],
      "@artlux/plugin-lidar-tracking/*": [
        "./plugins/lidar-tracking/src/*"
      ],
      "@artlux/plugin-ndi/main": [
        "./plugins/ndi/src/main.ts"
      ],
      "@artlux/plugin-ndi/renderer": [
        "./plugins/ndi/src/renderer.ts"
      ],
      "@artlux/plugin-calibration/main": [
        "./plugins/calibration/src/main.ts"
      ],
      "@artlux/plugin-calibration/renderer": [
        "./plugins/calibration/src/renderer.ts"
      ],
      "@artlux/plugin-spout/main": [
        "./plugins/spout/src/main.ts"
      ],
      "@artlux/plugin-spout/renderer": [
        "./plugins/spout/src/renderer.ts"
      ],
      "@artlux/plugin-hap/main": [
        "./plugins/hap/src/main.ts"
      ],
      "@artlux/plugin-hap/renderer": [
        "./plugins/hap/src/renderer.ts"
      ],
      "@artlux/plugin-mp4": [
        "./plugins/mp4/src/index.ts"
      ],
      "@artlux/plugin-mediapipe": [
        "./plugins/mediapipe/src/index.ts"
      ],
      "@artlux/plugin-augmenta": [
        "./plugins/augmenta/src/index.ts"
      ],
      "@artlux/plugin-augmenta/*": [
        "./plugins/augmenta/src/*"
      ],
      "@artlux/plugin-text": [
        "./plugins/text/src/index.ts"
      ],
      "@artlux/plugin-text/*": [
        "./plugins/text/src/*"
      ],
      "@artlux/plugin-shader/main": [
        "./plugins/shader/src/main.ts"
      ],
      "@artlux/plugin-shader/renderer": [
        "./plugins/shader/src/renderer.ts"
      ],
      "@artlux/plugin-show-control/main": [
        "./plugins/show-control/src/main.ts"
      ],
      "@artlux/plugin-show-control/renderer": [
        "./plugins/show-control/src/renderer.ts"
      ],
      "@artlux/plugin-audio/main": [
        "./plugins/audio/src/main.ts"
      ],
      "@artlux/plugin-audio/renderer": [
        "./plugins/audio/src/renderer.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // "native" holds C++/Rust only — no TypeScript of ours. It is excluded because CMake writes
  // `compiler_depend.ts` TIMESTAMP stubs into native/audio-engine/build (CMake's .ts, not
  // TypeScript's), and with no "include" this config sweeps the whole tree: the moment a contributor
  // ran `npm run build:audio` locally, `npm run verify` drowned in TS1127 parse errors from files
  // that are not code. CI never saw it — it builds the addon but does not typecheck afterwards.
  // `scripts/frame-exact` is a BUNDLER-BUILT harness, not app code: esbuild resolves its imports
  // through aliases that exist only in scripts/test-frame-exact.cjs (a stub for the host media
  // cache, and a direct path to the mp4 plugin), so tsc cannot resolve them and would fail the
  // whole verify on a file that is not shipped. It is typechecked by the bundle step instead.
  // `scripts/matte-gl` is the same arrangement for the same reason (its `@matte` alias is minted by
  // scripts/test-matte-gl.cjs), and the pair is the pattern to follow for any future harness: keep
  // the alias in the runner, keep the directory out of here, and let esbuild do the typechecking.
  "exclude": ["node_modules", "launcher", "native", "scripts/frame-exact", "scripts/matte-gl"]
}