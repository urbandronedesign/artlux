# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
out
release
*.local

# Rust / native addon build artifacts
native/**/target
*.node
# …except the prebuilt NDI addon: built once against the NDI 6 SDK and committed so CI/end
# users don't need the (gated) SDK — they only install the free NDI Runtime. Rebuild with
# `npm run build:ndi` (needs the SDK + LLVM) and re-commit when native/ndi/src changes.
!native/ndi/ndi.node
# …and the prebuilt projector-calibration addon (our small build artifact, like ndi.node): committed
# so CI/end users don't need OpenCV to RUN it. Rebuild with `npm run build:calib` (needs OpenCV 4.11
# + LLVM); re-commit when native/calib/src changes.
!native/calib/calib.node
# …and the prebuilt NVAPI warp/blend addon. Committed as a STUB (available()=false) so non-NVIDIA
# hosts build/run with the GLSL fallback; rebuild on a Quadro/RTX-pro machine with the NVAPI SDK
# (`npm run build:nvwarp` with NVAPI_SDK_DIR set) and re-commit the real one for distribution.
!native/nvwarp/nvwarp.node
# …but NOT its runtime dep, the 62 MB stock OpenCV world DLL — an unmodified redistributable, kept out
# of git to avoid history bloat on every OpenCV bump. `build:calib` copies it beside calib.node for
# dev, and electron-builder bundles it into the installer via extraResources for end users. To obtain
# it: run build:calib on a host with OpenCV, or copy from C:\opencv\build\x64\vc16\bin\.
native/calib/*.dll

# MediaPipe offline assets (WASM runtime + BlazePose .task models) — large binaries fetched with
# `npm run assets:mediapipe` (copies the WASM from node_modules + downloads the models). Kept out of
# git like the .node addons; Vite serves them from the renderer public dir in dev and copies them into
# out/renderer for packaged builds.
src/renderer/public/mediapipe/

# Generated documentation bundle (rebuild with `npm run docs:html`)
docs/user-guide/artlux-user-guide.html

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# graphify knowledge-graph outputs — keep only the 3 useful artifacts, ignore
# the regenerable vault/cache/manifest/cost and the transient .graphify_* temp files
graphify-out/*
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
# graphify-plugins: the plugins-scoped knowledge graph (same 3-artifact policy)
graphify-plugins/*
!graphify-plugins/graph.html
!graphify-plugins/GRAPH_REPORT.md
!graphify-plugins/graph.json
# stray graphify cache dumped under plugins/ by a scoped run — regenerable, never commit
plugins/graphify-out/
.graphify_*
