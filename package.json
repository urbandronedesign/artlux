{
  "name": "artlux",
  "private": true,
  "version": "0.25.4",
  "description": "GPU-accelerated addressable-LED pixel mapping for Art-Net / sACN",
  "author": "Zaki Jawhari and Bérenger Recoules",
  "license": "SEE LICENSE IN LICENSE",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:broadcast": "electron-vite build && electron . --broadcast",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "verify": "npm run verify:invariants && npm run verify:docs && npx tsc -p tsconfig.json --noEmit",
    "verify:invariants": "node scripts/verify-invariants.cjs",
    "verify:docs": "node scripts/verify-docs.cjs",
    "verify:plugins": "node scripts/verify-plugins.cjs",
    "verify:resources": "node scripts/verify-package-resources.cjs",
    "verify:macsign": "node scripts/verify-mac-signature.cjs",
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/preflight.ps1 -Mode all",
    "assets:mediapipe": "node scripts/fetch-mediapipe-assets.cjs",
    "fetch:redist": "node scripts/fetch-redist.cjs",
    "fetch:opencv": "node scripts/fetch-opencv-dll.cjs",
    "prepack:assets": "npm run fetch:redist && npm run fetch:opencv && npm run assets:mediapipe",
    "build:native": "cargo build --release --manifest-path native/output-engine/Cargo.toml && cargo build --release --manifest-path native/spout-receiver/Cargo.toml && cargo build --release --manifest-path native/hap/Cargo.toml && node scripts/copy-native.cjs && node scripts/build-audio.cjs --optional",
    "build:audio": "node scripts/build-audio.cjs",
    "build:fixtures": "node scripts/build-fixture-library.mjs",
    "build:ndi": "cargo build --release --features ndi --manifest-path native/ndi/Cargo.toml && node scripts/copy-ndi.cjs",
    "build:calib": "powershell -ExecutionPolicy Bypass -File scripts/build-calib.ps1",
    "build:nvwarp": "powershell -ExecutionPolicy Bypass -File scripts/build-nvwarp.ps1",
    "package": "npm run verify:invariants && npm run prepack:assets && node scripts/build-audio.cjs && electron-vite build && npm run verify:resources && electron-builder --publish never && npm run verify:macsign",
    "package:dir": "npm run verify:invariants && npm run prepack:assets && node scripts/build-audio.cjs && electron-vite build && npm run verify:resources && electron-builder --dir",
    "gen:brand": "node scripts/gen-wordmark.cjs && node scripts/gen-icon.cjs",
    "gen:icon": "node scripts/gen-icon.cjs",
    "docs:capture": "node scripts/capture-docs.cjs",
    "docs:gen": "node scripts/gen-docs-data.cjs",
    "docs:html": "node scripts/build-docs-html.cjs",
    "profile:trace": "node scripts/trace-cdp.cjs",
    "test:docktree": "tsc scripts/test-docktree.ts --outDir .tmp-docktree --target es2022 --module commonjs --moduleResolution node --skipLibCheck && node .tmp-docktree/scripts/test-docktree.js",
    "test:logic": "tsc -p scripts/tsconfig.test.json",
    "test:blend": "npm run test:logic && node .tmp-tests/scripts/test-blend.js",
    "test:recal": "npm run test:logic && node .tmp-tests/scripts/test-recal.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@xyflow/react": "^12.11.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.561.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.184.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.70",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.5",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "puppeteer-core": "^25.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.urbandronedesign.artlux",
    "productName": "ArtLux",
    "electronFuses": {
      "runAsNode": false,
      "resetAdHocDarwinSignature": true
    },
    "publish": {
      "provider": "github",
      "owner": "urbandronedesign",
      "repo": "artlux"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "native/output-engine/output-engine.node",
        "to": "output-engine.node"
      },
      {
        "from": "native/spout-receiver/spout-receiver.node",
        "to": "spout-receiver.node"
      },
      {
        "from": "native/hap/hap.node",
        "to": "hap.node"
      },
      {
        "from": "native/audio-engine/audio_engine.node",
        "to": "audio-engine.node"
      },
      {
        "from": "resources/fixture-library",
        "to": "fixture-library"
      },
      {
        "from": "examples",
        "to": "examples"
      },
      {
        "from": "scripts/lidar-emitter.cjs",
        "to": "scripts/lidar-emitter.cjs"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "*.md",
          "manifest.json"
        ]
      },
      {
        "from": "docs/user-guide",
        "to": "docs/user-guide"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "native/ndi/ndi.node",
          "to": "ndi.node"
        },
        {
          "from": "native/calib/calib.node",
          "to": "calib.node"
        },
        {
          "from": "native/calib/opencv_world4110.dll",
          "to": "opencv_world4110.dll"
        },
        {
          "from": "native/nvwarp/nvwarp.node",
          "to": "nvwarp.node"
        },
        {
          "from": "build/ndi/NDI-Runtime.exe",
          "to": "NDI-Runtime.exe"
        },
        {
          "from": "build/vcredist/vc_redist.x64.exe",
          "to": "vc_redist.x64.exe"
        },
        {
          "from": "scripts/preflight.ps1",
          "to": "scripts/preflight.ps1"
        },
        {
          "from": "scripts/verify-download.ps1",
          "to": "scripts/verify-download.ps1"
        },
        {
          "from": "scripts/install-watchdog-task.ps1",
          "to": "scripts/install-watchdog-task.ps1"
        },
        {
          "from": "scripts/uninstall-watchdog-task.ps1",
          "to": "scripts/uninstall-watchdog-task.ps1"
        },
        {
          "from": "scripts/watchdog-check.ps1",
          "to": "scripts/watchdog-check.ps1"
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "perMachine": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "directories": {
      "output": "release"
    }
  }
}
