{
  "name": "artlux",
  "private": true,
  "version": "0.14.7",
  "description": "GPU-accelerated addressable-LED pixel mapping for Art-Net / sACN",
  "author": "urbandronedesign <urbandrone@gmail.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:broadcast": "electron-vite build && electron . --broadcast",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:native": "cargo build --release --manifest-path native/output-engine/Cargo.toml && cargo build --release --manifest-path native/spout-receiver/Cargo.toml && cargo build --release --manifest-path native/hap/Cargo.toml && node scripts/copy-native.cjs",
    "build:ndi": "cargo build --release --features ndi --manifest-path native/ndi/Cargo.toml && node scripts/copy-ndi.cjs",
    "build:calib": "powershell -ExecutionPolicy Bypass -File scripts/build-calib.ps1",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "gen:icon": "node scripts/gen-icon.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.561.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.184.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.70",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.urbandronedesign.artlux",
    "productName": "ArtLux",
    "afterPack": "./scripts/mac-adhoc-sign.cjs",
    "publish": {
      "provider": "github",
      "owner": "urbandronedesign",
      "repo": "artlux"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "native/output-engine/output-engine.node",
        "to": "output-engine.node"
      },
      {
        "from": "native/spout-receiver/spout-receiver.node",
        "to": "spout-receiver.node"
      },
      {
        "from": "native/hap/hap.node",
        "to": "hap.node"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "native/ndi/ndi.node",
          "to": "ndi.node"
        },
        {
          "from": "native/calib/calib.node",
          "to": "calib.node"
        },
        {
          "from": "native/calib/opencv_world4110.dll",
          "to": "opencv_world4110.dll"
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "directories": {
      "output": "release"
    }
  }
}
