            "shaderId": "plasma",
            "shaderSource": "/*{\n  \"TITLE\": \"Home - slow tide\",\n  \"CATEGORIES\": [\"ambient\"],\n  \"INPUTS\": [\n    { \"NAME\": \"speed\", \"LABEL\": \"Speed\", \"TYPE\": \"float\", \"MIN\": 0.0, \"MAX\": 1.5, \"DEFAULT\": 0.25 },\n    { \"NAME\": \"glow\",  \"LABEL\": \"Glow\",  \"TYPE\": \"float\", \"MIN\": 0.0, \"MAX\": 2.0, \"DEFAULT\": 1.0 }\n  ]\n}*/\n// HOME. Deliberately the calmest of the three: wide, slow bands, deep blue-green. \"Nothing has been\n// triggered yet\" has to read from across the room, and the way it reads is by NOT moving much.\nvec4 shaderColor(vec2 uv) {\n  vec2 p = (uv - 0.5) * vec2(iAspect, 1.0);\n  float w = sin(p.y * 5.0 + iTime * speed)\n          + 0.5 * sin(p.x * 3.0 - iTime * speed * 0.7);\n  float t = clamp(0.5 + 0.25 * w, 0.0, 1.0);\n  vec3 col = mix(vec3(0.02, 0.06, 0.18), vec3(0.10, 0.55, 0.75), t);\n  return vec4(col * glow, 1.0);\n}",
