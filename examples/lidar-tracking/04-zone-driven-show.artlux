    {
      "id": "sc_two",
      "name": "Scene 2 (right)",
      "accent": "#d946ef",
      "fadeSec": 0,
      "globalBrightness": 1,
      "surfaces": [
        {
          "id": "srf_wall",
          "name": "Wall",
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 0.5,
          "rotation": 0,
          "zIndex": 1,
          "content": {
            "type": "SHADER",
            "shaderId": "plasma",
            "shaderSource": "/*{\n  \"TITLE\": \"State 2 - magenta scan\",\n  \"CATEGORIES\": [\"ambient\"],\n  \"INPUTS\": [\n    { \"NAME\": \"speed\", \"LABEL\": \"Speed\", \"TYPE\": \"float\", \"MIN\": 0.0, \"MAX\": 2.0, \"DEFAULT\": 0.6 },\n    { \"NAME\": \"glow\",  \"LABEL\": \"Glow\",  \"TYPE\": \"float\", \"MIN\": 0.0, \"MAX\": 2.0, \"DEFAULT\": 1.0 }\n  ]\n}*/\n// STATE 2 (the RIGHT pad). Magenta, hard bars sweeping sideways - a different COLOUR and a different\n// kind of motion from state 1, so the two are not merely two hues of the same look.\nvec4 shaderColor(vec2 uv) {\n  vec2 p = (uv - 0.5) * vec2(iAspect, 1.0);\n  float bars = sin(p.x * 14.0 - iTime * speed * 3.0);\n  float pulsing = 0.5 + 0.5 * sin(iTime * speed * 1.5);\n  float m = smoothstep(-0.2, 1.0, bars) * mix(0.55, 1.0, pulsing);\n  vec3 col = mix(vec3(0.10, 0.00, 0.14), vec3(0.85, 0.15, 0.75), m);\n  return vec4(col * glow, 1.0);\n}",
            "shaderRes": 1080,
            "opacity": 1
          }
        },
        {
          "id": "srf_floor",
          "name": "Floor",
          "x": 0,
          "y": 0.5,
          "width": 1,
          "height": 0.5,
