    {
      "id": "sc_one",
      "name": "Scene 1 (left)",
      "accent": "#f59e0b",
      "fadeSec": 0,
      "globalBrightness": 1,
      "surfaces": [
        {
          "id": "srf_wall",
          "name": "Wall",
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 0.5,
          "rotation": 0,
          "zIndex": 1,
          "content": {
            "type": "SHADER",
            "shaderId": "plasma",
            "shaderSource": "/*{\n  \"TITLE\": \"State 1 - amber bloom\",\n  \"CATEGORIES\": [\"ambient\"],\n  \"INPUTS\": [\n    { \"NAME\": \"speed\", \"LABEL\": \"Speed\", \"TYPE\": \"float\", \"MIN\": 0.0, \"MAX\": 2.0, \"DEFAULT\": 0.7 },\n    { \"NAME\": \"glow\",  \"LABEL\": \"Glow\",  \"TYPE\": \"float\", \"MIN\": 0.0, \"MAX\": 2.0, \"DEFAULT\": 1.0 }\n  ]\n}*/\n// STATE 1 (the LEFT pad). Amber, radial, clearly busier than home - you should be able to tell which\n// state the room is in from the far side of it, without reading a label.\nvec4 shaderColor(vec2 uv) {\n  vec2 p = (uv - 0.5) * vec2(iAspect, 1.0);\n  float r = length(p);\n  float ang = atan(p.y, p.x);\n  float petals = 0.5 + 0.5 * sin(ang * 6.0 + iTime * speed * 2.0 - r * 8.0);\n  float falloff = smoothstep(0.95, 0.0, r);\n  vec3 col = mix(vec3(0.18, 0.04, 0.00), vec3(1.00, 0.62, 0.15), petals * falloff);\n  return vec4(col * glow, 1.0);\n}",
            "shaderRes": 1080,
            "opacity": 1
          }
        },
        {
          "id": "srf_floor",
          "name": "Floor",
          "x": 0,
          "y": 0.5,
          "width": 1,
          "height": 0.5,
          "rotation": 0,
          "zIndex": 0,
          "content": {
            "type": "TRACKING",
            "trackingSource": "SOL",
            "bgLayerId": "lay_pads",
            "blobSize": 0.06,
            "showIds": true,
            "trail": true,
            "trailSeconds": 0.8,
            "flipH": false,
            "flipV": false,
            "rotate": 0,
            "calibration": true,
            "opacity": 1
          }
        }
      ],
