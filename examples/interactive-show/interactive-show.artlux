          {
            "id": "clip_story_a_floor",
            "layerId": "lay_story_a_floor",
            "name": "Floor pads",
            "path": "",
            "start": 0,
            "duration": 20,
            "inPoint": 0,
            "content": {
              "type": "SHADER",
              "shaderId": "plasma",
              "shaderSource": "/*{\n  \"TITLE\": \"Floor pads\",\n  \"CATEGORIES\": [\"ambient\"],\n  \"INPUTS\": [\n    { \"NAME\": \"show_zn_entrance\", \"LABEL\": \"Entrance\", \"TYPE\": \"bool\", \"DEFAULT\": true },\n    { \"NAME\": \"show_zn_left\", \"LABEL\": \"Left pad\", \"TYPE\": \"bool\", \"DEFAULT\": true },\n    { \"NAME\": \"show_zn_right\", \"LABEL\": \"Right pad\", \"TYPE\": \"bool\", \"DEFAULT\": true },\n    { \"NAME\": \"border\",   \"LABEL\": \"Border\",     \"TYPE\": \"float\", \"MIN\": 0.002, \"MAX\": 0.08, \"DEFAULT\": 0.016 },\n    { \"NAME\": \"pulse\",    \"LABEL\": \"Pulse rate\", \"TYPE\": \"float\", \"MIN\": 0.0,   \"MAX\": 3.0,  \"DEFAULT\": 0.8 },\n    { \"NAME\": \"interior\", \"LABEL\": \"Interior\",   \"TYPE\": \"float\", \"MIN\": 0.0,   \"MAX\": 0.6,  \"DEFAULT\": 0.12 }\n  ]\n}*/\n// THE PADS A VISITOR STANDS ON — the floor surface's background, with the live visitor markers drawn\n// over it by the TRACKING content. GENERATED by make-project.cjs from the trigger zones: do not\n// hand-edit, move a zone there and re-run it.\nfloat padCover(vec2 uv, vec4 r, float breath) {\n  if (uv.x < r.x || uv.x > r.z || uv.y < r.y || uv.y > r.w) return 0.0;\n  float dx = min(uv.x - r.x, r.z - uv.x) * iAspect;\n  float dy = min(uv.y - r.y, r.w - uv.y);\n  float ring = 1.0 - smoothstep(border * 0.45, border, min(dx, dy));\n  return max(ring * breath, interior);\n}\n\nvec4 shaderColor(vec2 uv) {\n  float breath = 0.65 + 0.35 * sin(iTime * pulse * 6.2831853);\n  vec3 col = vec3(0.0);\n  float a = 0.0;\n  if (show_zn_entrance) { float t = padCover(uv, vec4(0.3600, 0.0400, 0.6400, 0.3000), breath); col += vec3(0.9608, 0.6196, 0.0431) * t; a = max(a, t); }\n  if (show_zn_left) { float t = padCover(uv, vec4(0.0600, 0.4500, 0.3200, 0.8500), breath); col += vec3(0.0627, 0.7255, 0.5059) * t; a = max(a, t); }\n  if (show_zn_right) { float t = padCover(uv, vec4(0.6800, 0.4500, 0.9400, 0.8500), breath); col += vec3(0.8510, 0.2745, 0.9373) * t; a = max(a, t); }\n  return vec4(col, a);   // premultiplied — the shader context is premultipliedAlpha:true\n}",
              "shaderRes": 1080,
              "opacity": 1,
              "shaderParams": {
                "show_zn_entrance": true,
                "show_zn_left": false,
                "show_zn_right": false
              }
            }
