    {
      "id": "srf_screen",
      "name": "Screen",
      "x": 0.1,
      "y": 0.1,
      "width": 0.8,
      "height": 0.45,
      "rotation": 0,
      "zIndex": 0,
      "aspect": "16:9",
      "portrait": false,
      "content": {
        "type": "SHADER",
        "shaderId": "plasma",
        "shaderSource": "/*{\n  \"TITLE\": \"Calibration test card\",\n  \"CATEGORIES\": [\"utility\"],\n  \"INPUTS\": [\n    { \"NAME\": \"line\", \"LABEL\": \"Line width\", \"TYPE\": \"float\", \"MIN\": 0.002, \"MAX\": 0.02, \"DEFAULT\": 0.006 },\n    { \"NAME\": \"cells\", \"LABEL\": \"Cells across\", \"TYPE\": \"float\", \"MIN\": 4.0, \"MAX\": 32.0, \"DEFAULT\": 16.0 }\n  ]\n}*/\n// A CALIBRATION TEST CARD — generated by make-project.cjs. Everything is measured in picture HEIGHTS\n// (uv.y units; x is scaled by iAspect), so a cell is square and a line is the same width both ways on\n// any aspect.\nfloat box(vec2 p, vec2 lo, vec2 hi) { return step(lo.x, p.x) * step(p.x, hi.x) * step(lo.y, p.y) * step(p.y, hi.y); }\n\nvec4 shaderColor(vec2 uv) {\n  vec2 p = vec2(uv.x * iAspect, uv.y);          // picture-height units: x 0..iAspect, y 0..1\n  vec3 col = vec3(0.07);\n\n  // Grid of square cells, \"cells\" of them across the width.\n  float cell = iAspect / cells;\n  vec2 g = abs(fract(p / cell + 0.5) - 0.5) * cell;\n  col = mix(col, vec3(0.42), step(min(g.x, g.y), line * 0.5));\n\n  // Centre: a ring a third of the height across, and a cross through it.\n  vec2 c = p - vec2(iAspect * 0.5, 0.5);\n  col = mix(col, vec3(1.0), step(abs(length(c) - 0.17), line * 0.6));\n  col = mix(col, vec3(1.0), step(min(abs(c.x), abs(c.y)), line * 0.5) * step(length(c), 0.22));\n\n  // Four coloured corners — TOP-LEFT red, TOP-RIGHT green, BOTTOM-RIGHT blue, BOTTOM-LEFT yellow.\n  float s = 0.11;\n  col = mix(col, vec3(0.95, 0.15, 0.15), box(p, vec2(0.0, 1.0 - s), vec2(s, 1.0)));\n  col = mix(col, vec3(0.15, 0.85, 0.30), box(p, vec2(iAspect - s, 1.0 - s), vec2(iAspect, 1.0)));\n  col = mix(col, vec3(0.20, 0.45, 1.00), box(p, vec2(iAspect - s, 0.0), vec2(iAspect, s)));\n  col = mix(col, vec3(1.00, 0.85, 0.10), box(p, vec2(0.0, 0.0), vec2(s, s)));\n\n  // An arrow above the ring, pointing UP — readable without remembering the colours.\n  vec2 a = c - vec2(0.0, 0.30);\n  float tri = step(0.0, a.y) * step(a.y, 0.08) * step(abs(a.x), (0.08 - a.y) * 0.75);\n  col = mix(col, vec3(1.0), tri);\n\n  // The border, last, so it is never covered: this is the line that lands on the screen's edges.\n  float edge = min(min(p.x, iAspect - p.x), min(p.y, 1.0 - p.y));\n  col = mix(col, vec3(1.0), step(edge, line * 1.5));\n  return vec4(col, 1.0);\n}",
        "shaderRes": 1080,
        "opacity": 1
      }
    }
  ],
